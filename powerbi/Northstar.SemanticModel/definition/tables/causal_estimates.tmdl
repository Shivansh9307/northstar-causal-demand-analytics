		sourceColumn: true_log_effect

		annotation SummarizationSetBy = Automatic

	column true_effect_pct
		dataType: double
		formatString: #,0.00
		lineageTag: 4be87024-5f37-423d-aa77-c0ec67628aec
		summarizeBy: sum
		sourceColumn: true_effect_pct

		annotation SummarizationSetBy = Automatic

	column error_log
		dataType: double
		formatString: #,0.0000
		lineageTag: b7d3c8e8-4eaf-4dfa-94cd-5d0df503e22d
		summarizeBy: sum
		sourceColumn: error_log

		annotation SummarizationSetBy = Automatic

	column error_pp
		dataType: double
