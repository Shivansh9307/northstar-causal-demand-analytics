table causal_estimates
	lineageTag: c40b30fd-2056-4305-bf96-9b3f9bbd6683

	measure 'Naive Promo Lift %' =
			CALCULATE (
			    MAX ( causal_estimates[effect_pct] ),
			    causal_estimates[method] = "promoted rows vs all others"
			)
		formatString: #,0.00
		lineageTag: 37fe856e-a060-4623-9546-aa0e3d54f569

	measure 'Causal Promo Lift %' =
			CALCULATE (
			    MAX ( causal_estimates[effect_pct] ),
			    causal_estimates[method] = "DiD: uncannibalised + seasonal effects"
			)
		formatString: #,0.00
		lineageTag: 8d25f491-5260-4e16-80ab-991429152ba7

	measure 'True Promo Lift %' = MAX ( causal_estimates[true_effect_pct] )
		formatString: #,0.00
		lineageTag: 6604da88-f9cb-46d9-80e6-4ae1794e6eb1

	measure 'Naive Bias pp' = [Naive Promo Lift %] - [True Promo Lift %]
		formatString: #,0.00
		lineageTag: c6fd9ead-d0bf-4ece-8ec5-35f97336f132

	measure 'Causal Bias pp' = [Causal Promo Lift %] - [True Promo Lift %]
		formatString: #,0.00
		lineageTag: 24bb8416-7ba5-4342-9467-4fbf24e77770

	measure 'Bias Removed %' =
			VAR NaiveError =
			    ABS (
			        CALCULATE (
			            MAX ( causal_estimates[error_log] ),
			            causal_estimates[method] = "promoted rows vs all others"
			        )
			    )
			VAR CausalError =
			    ABS (
			        CALCULATE (
			            MAX ( causal_estimates[error_log] ),
			            causal_estimates[method] = "DiD: uncannibalised + seasonal effects"
			        )
			    )
			RETURN ( 1 - DIVIDE ( CausalError, NaiveError ) ) * 100
		formatString: #,0.00
		lineageTag: 57071670-3a9f-4fad-a1c4-b66c9853b23e

	measure 'Estimate Health' =
			SWITCH (
			    TRUE (),
			    ABS ( [Causal Bias pp] ) <= 10, "Within 10pp of truth",
			    ABS ( [Causal Bias pp] ) <= 20, "Within 20pp — upper bound",
			    "Large residual bias"
			)
		lineageTag: a5e5aaf9-1e94-4107-b9ff-d9bb37f2a2e2

	measure 'Effect %' = MAX ( causal_estimates[effect_pct] )
		formatString: #,0.0
		lineageTag: 83283e61-8b2a-48b6-8fec-8cbb32df2034

	column method
		dataType: string
		formatString: #,0.0000
		lineageTag: 81f7a7d0-9065-441b-890f-afe84dd61b6a
		summarizeBy: none
		sourceColumn: method

		annotation SummarizationSetBy = Automatic

	column family
		dataType: string
		formatString: #,0.0000
