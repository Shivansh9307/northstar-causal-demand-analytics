table promo_plan
	lineageTag: 682205a0-c18c-4151-9221-11fa51fc30a3

	measure 'Promotions Selected' = COUNTROWS ( promo_plan )
		lineageTag: a2f4512c-f1d2-497e-95b9-e29683ab4528

	measure 'Plan Spend' = SUM ( promo_plan[promotion_cost] )
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		lineageTag: 2b9893f1-1389-481c-ba3e-1cbd69f008ca

	measure 'Plan Incremental Profit' = SUM ( promo_plan[incremental_profit] )
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		lineageTag: 0594894e-c8f5-4994-bb8f-c96814618468

	measure 'Scenario Incremental Profit' =
			VAR Multiplier = SELECTEDVALUE ( 'Uplift Scenario'[Uplift Scenario], 1 )
			RETURN
			    SUMX (
			        promo_plan,
			        ( promo_plan[baseline_units] + promo_plan[incremental_units] * Multiplier )
			            * promo_plan[promo_margin]
			            - promo_plan[baseline_units] * promo_plan[full_margin]
			            - promo_plan[cannibalisation_loss]
			    )
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		lineageTag: 374e6a89-c18b-4cad-8c3f-1f1ef25f570d

	measure 'Scenario vs Plan' = [Scenario Incremental Profit] - [Plan Incremental Profit]
		lineageTag: f238c4e1-8235-4e36-8b69-32b29f8c146e

	measure 'Scenario Verdict' =
			IF (
			    [Scenario Incremental Profit] < 0,
			    "Plan loses money at this uplift",
			    "Plan remains profitable"
			)
		lineageTag: e89d0977-c801-48ae-8996-1b352eef690b

	column store_id
		dataType: string
		formatString: #,0.0000
		lineageTag: e8724c38-636c-4cf3-8a24-3af6b1c6705e
		summarizeBy: none
		sourceColumn: store_id

		annotation SummarizationSetBy = Automatic

	column sku_id
		dataType: string
		formatString: #,0.0000
