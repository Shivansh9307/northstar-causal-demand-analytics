		annotation SummarizationSetBy = Automatic

	partition promo_plan = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "promo_plan.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"store_id", type text}, {"sku_id", type text}, {"category", type text}, {"discount_pct", Int64.Type}, {"baseline_units", type number}, {"incremental_units", type number}, {"promo_margin", type number}, {"full_margin", type number}, {"promotion_cost", type number}, {"cannibalisation_loss", type number}, {"incremental_profit", type number}})
				in
				    Typed

