		dataType: int64
		formatString: #,0
		lineageTag: a09afcc6-f846-45f6-9bc6-44f4a7120340
		summarizeBy: sum
		sourceColumn: discount_pct

		annotation SummarizationSetBy = Automatic

	column baseline_units
